NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3100
DATABASE_URL=postgresql://nuvex_billing:nuvex_billing@localhost:5432/nuvex_billing?schema=public

# Orígenes web permitidos, separados por coma. Vacío deshabilita CORS.
CORS_ORIGINS=http://localhost:3000

# Cantidad de proxies confiables delante de la API. Use 0 en desarrollo local.
TRUST_PROXY_HOPS=0

# Límite general por IP y ventana en milisegundos.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120

# Genere valores distintos por ambiente. No los confirme en Git.
# SECRETS_ENCRYPTION_KEY debe ser exactamente 32 bytes codificados en base64.
SECRETS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
API_KEY_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Protege /v1/admin/*. Debe tener al menos 32 caracteres aleatorios.
PLATFORM_ADMIN_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Cloudflare R2 privado compartido con Nuvex. Use los mismos valores del backend Nuvex.
# Billing conserva sus objetos bajo tenants/{tenantId}/... dentro del bucket privado.
CLOUDFLARE_R2_ACCOUNT_ID=REPLACE_WITH_NUVEX_ACCOUNT_ID
CLOUDFLARE_R2_ACCESS_KEY_ID=REPLACE_WITH_NUVEX_ACCESS_KEY
CLOUDFLARE_R2_SECRET_ACCESS_KEY=REPLACE_WITH_NUVEX_SECRET_KEY
CLOUDFLARE_R2_PRIVATE_BUCKET=REPLACE_WITH_NUVEX_PRIVATE_BUCKET
CLOUDFLARE_R2_SIGNED_URL_TTL_SECONDS=300

# Cola PostgreSQL del worker.
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=4
WORKER_LOCK_TIMEOUT_MS=120000
WORKER_RETRY_BASE_MS=5000
WORKER_RETRY_MAX_MS=900000

# Servicio oficial de pruebas SUNAT. No usar BETA para comprobantes reales.
SUNAT_BETA_BILL_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
# Receptor oficial para facturas, boletas, notas, RC y RA reales.
SUNAT_PRODUCTION_BILL_ENDPOINT=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
SUNAT_SOAP_TIMEOUT_MS=60000
SUNAT_MAX_RESPONSE_BYTES=10485760

# Entregas webhook durables y firmadas.
WEBHOOK_POLL_INTERVAL_MS=1000
WEBHOOK_CONCURRENCY=8
WEBHOOK_LOCK_TIMEOUT_MS=60000
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRY_BASE_MS=10000
WEBHOOK_RETRY_MAX_MS=900000
