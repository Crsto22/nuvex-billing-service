generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Environment {
  BETA
  PRODUCTION
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  ACTIVE
  DISABLED
}

enum AuditActorType {
  PLATFORM_ADMIN
  API_KEY
  SYSTEM
}

enum DocumentType {
  INVOICE
  RECEIPT
  CREDIT_NOTE
  DEBIT_NOTE
  DESPATCH_GUIDE
}

enum DespatchGuideStatus {
  REGISTERED
  PROCESSING
  VALIDATED_BETA
  ACCEPTED
  ACCEPTED_WITH_OBSERVATIONS
  REJECTED
  FAILED
  CANCELLATION_REQUESTED
  CANCELLED
}

enum DespatchTransportMode {
  PUBLIC
  PRIVATE
}

enum DocumentStatus {
  RECEIVED
  VALIDATING
  QUEUED
  PROCESSING
  ACCEPTED
  ACCEPTED_WITH_OBSERVATIONS
  REJECTED
  RETRY_SCHEDULED
  FAILED
  VOIDED
}

enum PaymentMethod {
  CASH
  CREDIT
}

enum EmissionJobStatus {
  PENDING
  PROCESSING
  DONE
  DEAD
}

enum EmissionOperation {
  ISSUE
}

enum DailySummaryStatus {
  BUILDING
  SUBMITTED
  PROCESSING
  ACCEPTED
  REJECTED
  FAILED
}

enum DailySummaryItemStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SunatVoidProcedure {
  VOIDED_DOCUMENTS
  DAILY_SUMMARY
  GRE_SOL
}

enum SunatVoidRequestStatus {
  PENDING
  MANUAL_ACTION_REQUIRED
  SUBMITTED
  PROCESSING
  ACCEPTED
  REJECTED
  FAILED
}

enum ArtifactType {
  XML
  ZIP
  CDR
  PDF
  PDF_A4
  PDF_TICKET
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD
}

model Tenant {
  id                String             @id @default(uuid()) @db.Uuid
  ruc               String             @unique @db.VarChar(11)
  legalName         String             @map("legal_name") @db.VarChar(200)
  tradeName         String?            @map("trade_name") @db.VarChar(200)
  address           String?            @db.VarChar(255)
  ubigeo            String?            @db.VarChar(6)
  status            TenantStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  applications      Application[]
  auditEvents       AuditEvent[]
  taxCredentials    TaxCredential[]
  establishments    Establishment[]
  fiscalSeries      FiscalSeries[]
  taxDocuments      TaxDocument[]
  dailySummaries    DailySummary[]
  despatchGuides    DespatchGuide[]
  sunatVoidRequests SunatVoidRequest[]
  branding          TenantBranding?

  @@index([status])
  @@index([createdAt])
  @@map("tenant")
}

model TenantBranding {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  version          Int      @default(1)
  sourceFileName   String   @map("source_file_name") @db.VarChar(180)
  sourceMimeType   String   @map("source_mime_type") @db.VarChar(50)
  sourceSizeBytes  Int      @map("source_size_bytes")
  sourceWidth      Int      @map("source_width")
  sourceHeight     Int      @map("source_height")
  masterObjectKey  String   @map("master_object_key") @db.VarChar(600)
  masterSizeBytes  Int      @map("master_size_bytes")
  masterSha256     String   @map("master_sha256") @db.VarChar(64)
  masterWidth      Int      @map("master_width")
  masterHeight     Int      @map("master_height")
  pdfObjectKey     String   @map("pdf_object_key") @db.VarChar(600)
  pdfSizeBytes     Int      @map("pdf_size_bytes")
  pdfSha256        String   @map("pdf_sha256") @db.VarChar(64)
  pdfWidth         Int      @map("pdf_width")
  pdfHeight        Int      @map("pdf_height")
  previewObjectKey String   @map("preview_object_key") @db.VarChar(600)
  previewSizeBytes Int      @map("preview_size_bytes")
  previewSha256    String   @map("preview_sha256") @db.VarChar(64)
  previewWidth     Int      @map("preview_width")
  previewHeight    Int      @map("preview_height")
  uploadedAt       DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@map("tenant_branding")
}

model TaxCredential {
  id                           String      @id @default(uuid()) @db.Uuid
  tenantId                     String      @map("tenant_id") @db.Uuid
  environment                  Environment
  solUsernameEncrypted         String?     @map("sol_username_encrypted") @db.Text
  solPasswordEncrypted         String?     @map("sol_password_encrypted") @db.Text
  clientIdEncrypted            String?     @map("client_id_encrypted") @db.Text
  clientSecretEncrypted        String?     @map("client_secret_encrypted") @db.Text
  certificateObjectKey         String?     @map("certificate_object_key") @db.VarChar(600)
  certificatePasswordEncrypted String?     @map("certificate_password_encrypted") @db.Text
  certificateFileName          String?     @map("certificate_file_name") @db.VarChar(180)
  certificateMimeType          String?     @map("certificate_mime_type") @db.VarChar(100)
  certificateSizeBytes         Int?        @map("certificate_size_bytes")
  certificateFingerprint       String?     @map("certificate_fingerprint") @db.VarChar(64)
  certificateSerialNumber      String?     @map("certificate_serial_number") @db.VarChar(128)
  certificateSubject           String?     @map("certificate_subject") @db.Text
  certificateIssuer            String?     @map("certificate_issuer") @db.Text
  certificateValidFrom         DateTime?   @map("certificate_valid_from") @db.Timestamptz(6)
  certificateExpiresAt         DateTime?   @map("certificate_expires_at") @db.Timestamptz(6)
  certificateUploadedAt        DateTime?   @map("certificate_uploaded_at") @db.Timestamptz(6)
  active                       Boolean     @default(false)
  createdAt                    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, environment])
  @@index([tenantId, active])
  @@index([certificateExpiresAt])
  @@map("tax_credential")
}

model Application {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  name               String              @db.VarChar(120)
  code               String              @db.VarChar(50)
  status             ApplicationStatus   @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys            ApiKey[]
  fiscalSeries       FiscalSeries[]
  taxDocuments       TaxDocument[]
  idempotencyRecords IdempotencyRecord[]
  webhookEndpoints   WebhookEndpoint[]
  webhookEvents      WebhookEvent[]
  despatchGuides     DespatchGuide[]
  sunatVoidRequests  SunatVoidRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("application")
}

model Establishment {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  code         String         @db.VarChar(10)
  name         String         @db.VarChar(120)
  address      String         @db.VarChar(255)
  ubigeo       String         @db.VarChar(6)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalSeries FiscalSeries[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("establishment")
}

model FiscalSeries {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  applicationId   String          @map("application_id") @db.Uuid
  establishmentId String          @map("establishment_id") @db.Uuid
  environment     Environment
  documentType    DocumentType    @map("document_type")
  series          String          @db.VarChar(4)
  currentNumber   Int             @default(0) @map("current_number")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  establishment   Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  taxDocuments    TaxDocument[]
  despatchGuides  DespatchGuide[]

  @@unique([tenantId, environment, documentType, series])
  @@index([applicationId, environment, active])
  @@map("fiscal_series")
}

model TaxDocument {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  applicationId      String                 @map("application_id") @db.Uuid
  fiscalSeriesId     String                 @map("fiscal_series_id") @db.Uuid
  externalId         String                 @map("external_id") @db.VarChar(100)
  environment        Environment
  documentType       DocumentType           @map("document_type")
  status             DocumentStatus         @default(QUEUED)
  series             String                 @db.VarChar(4)
  number             Int
  issueDate          DateTime               @map("issue_date") @db.Date
  issueTime          String?                @map("issue_time") @db.VarChar(8)
  currency           String                 @db.Char(3)
  paymentMethod      PaymentMethod          @map("payment_method")
  amountDue          Decimal?               @map("amount_due") @db.Decimal(18, 2)
  calculationVersion String                 @map("calculation_version") @db.VarChar(40)
  issuerSnapshot     Json                   @map("issuer_snapshot")
  brandingSnapshot   Json?                  @map("branding_snapshot")
  customerSnapshot   Json                   @map("customer_snapshot")
  requestPayload     Json                   @map("request_payload")
  normalizedPayload  Json                   @map("normalized_payload")
  metadata           Json?
  taxableAmount      Decimal                @map("taxable_amount") @db.Decimal(18, 2)
  exemptAmount       Decimal                @map("exempt_amount") @db.Decimal(18, 2)
  unaffectedAmount   Decimal                @map("unaffected_amount") @db.Decimal(18, 2)
  discountAmount     Decimal                @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxAmount          Decimal                @map("tax_amount") @db.Decimal(18, 2)
  totalAmount        Decimal                @map("total_amount") @db.Decimal(18, 2)
  sunatCode          String?                @map("sunat_code") @db.VarChar(40)
  sunatMessage       String?                @map("sunat_message") @db.VarChar(1000)
  sunatObservations  String[]               @default([]) @map("sunat_observations")
  sunatHash          String?                @map("sunat_hash") @db.VarChar(128)
  reasonCode         String?                @map("reason_code") @db.VarChar(2)
  reasonDescription  String?                @map("reason_description") @db.VarChar(500)
  submittedAt        DateTime?              @map("submitted_at") @db.Timestamptz(6)
  respondedAt        DateTime?              @map("responded_at") @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  application        Application            @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  fiscalSeries       FiscalSeries           @relation(fields: [fiscalSeriesId], references: [id], onDelete: Restrict)
  lines              TaxDocumentLine[]
  installments       PaymentInstallment[]
  emissionJobs       EmissionJob[]
  artifacts          Artifact[]
  webhookEvents      WebhookEvent[]
  summaryItems       DailySummaryItem[]
  references         TaxDocumentReference[] @relation("DocumentReferences")
  referencedBy       TaxDocumentReference[] @relation("ReferencedDocuments")
  noteAdjustments    TaxNoteAdjustment[]
  voidRequest        SunatVoidRequest?

  @@unique([applicationId, environment, externalId])
  @@unique([tenantId, environment, documentType, series, number])
  @@index([applicationId, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("tax_document")
}

model TaxNoteAdjustment {
  id                  String      @id @default(uuid()) @db.Uuid
  documentId          String      @map("document_id") @db.Uuid
  referenceLineNumber Int         @map("reference_line_number")
  quantity            Decimal?    @db.Decimal(18, 10)
  amount              Decimal     @db.Decimal(18, 2)
  description         String?     @db.VarChar(500)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  document            TaxDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, referenceLineNumber])
  @@index([referenceLineNumber])
  @@map("tax_note_adjustment")
}

model TaxDocumentReference {
  id                   String       @id @default(uuid()) @db.Uuid
  documentId           String       @map("document_id") @db.Uuid
  referencedDocumentId String       @map("referenced_document_id") @db.Uuid
  referencedType       DocumentType @map("referenced_type")
  referencedSeries     String       @map("referenced_series") @db.VarChar(4)
  referencedNumber     Int          @map("referenced_number")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  document             TaxDocument  @relation("DocumentReferences", fields: [documentId], references: [id], onDelete: Cascade)
  referencedDocument   TaxDocument  @relation("ReferencedDocuments", fields: [referencedDocumentId], references: [id], onDelete: Restrict)

  @@unique([documentId, referencedDocumentId])
  @@index([referencedDocumentId, createdAt])
  @@map("tax_document_reference")
}

model DespatchGuide {
  id                        String                  @id @default(uuid()) @db.Uuid
  tenantId                  String                  @map("tenant_id") @db.Uuid
  applicationId             String                  @map("application_id") @db.Uuid
  fiscalSeriesId            String                  @map("fiscal_series_id") @db.Uuid
  externalId                String                  @map("external_id") @db.VarChar(100)
  environment               Environment
  status                    DespatchGuideStatus     @default(REGISTERED)
  series                    String                  @db.VarChar(4)
  number                    Int
  issueDate                 DateTime                @map("issue_date") @db.Date
  issueTime                 String                  @default("00:00:00") @map("issue_time") @db.VarChar(8)
  transferStartDate         DateTime                @map("transfer_start_date") @db.Date
  carrierDeliveryDate       DateTime?               @map("carrier_delivery_date") @db.Date
  transferReasonCode        String                  @map("transfer_reason_code") @db.VarChar(2)
  transferReasonDescription String?                 @map("transfer_reason_description") @db.VarChar(250)
  transportMode             DespatchTransportMode   @map("transport_mode")
  grossWeight               Decimal                 @map("gross_weight") @db.Decimal(18, 3)
  weightUnit                String                  @default("KGM") @map("weight_unit") @db.VarChar(3)
  packageCount              Int?                    @map("package_count")
  departureUbigeo           String                  @map("departure_ubigeo") @db.VarChar(6)
  departureAddress          String                  @map("departure_address") @db.VarChar(255)
  arrivalUbigeo             String?                 @map("arrival_ubigeo") @db.VarChar(6)
  arrivalAddress            String?                 @map("arrival_address") @db.VarChar(255)
  relatedDocumentType       String?                 @map("related_document_type") @db.VarChar(2)
  relatedDocumentNumber     String?                 @map("related_document_number") @db.VarChar(50)
  issuerSnapshot            Json                    @map("issuer_snapshot")
  brandingSnapshot          Json?                   @map("branding_snapshot")
  requestPayload            Json                    @map("request_payload")
  metadata                  Json?
  sunatCode                 String?                 @map("sunat_code") @db.VarChar(40)
  sunatMessage              String?                 @map("sunat_message") @db.VarChar(1000)
  sunatObservations         String[]                @default([]) @map("sunat_observations")
  sunatHash                 String?                 @map("sunat_hash") @db.VarChar(128)
  sunatTicket               String?                 @map("sunat_ticket") @db.VarChar(120)
  cancellationReason        String?                 @map("cancellation_reason") @db.VarChar(250)
  cancellationRequestedAt   DateTime?               @map("cancellation_requested_at") @db.Timestamptz(6)
  cancelledAt               DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  submittedAt               DateTime?               @map("submitted_at") @db.Timestamptz(6)
  respondedAt               DateTime?               @map("responded_at") @db.Timestamptz(6)
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  application               Application             @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  fiscalSeries              FiscalSeries            @relation(fields: [fiscalSeriesId], references: [id], onDelete: Restrict)
  recipient                 DespatchGuideRecipient?
  carrier                   DespatchGuideCarrier?
  vehicles                  DespatchGuideVehicle[]
  drivers                   DespatchGuideDriver[]
  items                     DespatchGuideItem[]
  relatedDocuments          DespatchGuideRelatedDocument[]
  artifacts                 DespatchGuideArtifact[]
  webhookEvents             WebhookEvent[]
  voidRequest               SunatVoidRequest?
  emissionJob               DespatchGuideEmissionJob?

  @@unique([applicationId, externalId])
  @@unique([tenantId, environment, series, number])
  @@index([applicationId, createdAt])
  @@index([tenantId, environment, status, createdAt])
  @@map("despatch_guide")
}

model DespatchGuideRelatedDocument {
  id           String        @id @default(uuid()) @db.Uuid
  guideId      String        @map("guide_id") @db.Uuid
  documentType String        @map("document_type") @db.VarChar(2)
  number       String        @db.VarChar(100)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  guide        DespatchGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, documentType, number])
  @@index([guideId, createdAt])
  @@map("despatch_guide_related_document")
}

model DespatchGuideEmissionJob {
  id               String            @id @default(uuid()) @db.Uuid
  guideId          String            @unique @map("guide_id") @db.Uuid
  status           EmissionJobStatus @default(PENDING)
  attempts         Int               @default(0)
  maxAttempts      Int               @default(20) @map("max_attempts")
  nextAttemptAt    DateTime          @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt         DateTime?         @map("locked_at") @db.Timestamptz(6)
  lockedBy         String?           @map("locked_by") @db.VarChar(100)
  lastErrorCode    String?           @map("last_error_code") @db.VarChar(40)
  lastErrorMessage String?           @map("last_error_message") @db.VarChar(1000)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt      DateTime?         @map("processed_at") @db.Timestamptz(6)
  guide            DespatchGuide     @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("despatch_guide_emission_job")
}

model DespatchGuideRecipient {
  id             String        @id @default(uuid()) @db.Uuid
  guideId        String        @unique @map("guide_id") @db.Uuid
  documentType   String        @map("document_type") @db.VarChar(20)
  documentNumber String        @map("document_number") @db.VarChar(20)
  name           String        @db.VarChar(200)
  address        String?       @db.VarChar(255)
  ubigeo         String?       @db.VarChar(6)
  guide          DespatchGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@map("despatch_guide_recipient")
}

model DespatchGuideCarrier {
  id                    String        @id @default(uuid()) @db.Uuid
  guideId               String        @unique @map("guide_id") @db.Uuid
  ruc                   String        @db.VarChar(11)
  legalName             String        @map("legal_name") @db.VarChar(200)
  mtcRegistrationNumber String?       @map("mtc_registration_number") @db.VarChar(30)
  guide                 DespatchGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@map("despatch_guide_carrier")
}

model DespatchGuideVehicle {
  id                  String        @id @default(uuid()) @db.Uuid
  guideId             String        @map("guide_id") @db.Uuid
  plate               String        @db.VarChar(10)
  brand               String?       @db.VarChar(60)
  authorizationNumber String?       @map("authorization_number") @db.VarChar(50)
  primary             Boolean       @default(false)
  guide               DespatchGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, plate])
  @@index([guideId, primary])
  @@map("despatch_guide_vehicle")
}

model DespatchGuideDriver {
  id             String        @id @default(uuid()) @db.Uuid
  guideId        String        @map("guide_id") @db.Uuid
  documentType   String        @map("document_type") @db.VarChar(20)
  documentNumber String        @map("document_number") @db.VarChar(20)
  firstNames     String        @map("first_names") @db.VarChar(100)
  lastNames      String        @map("last_names") @db.VarChar(100)
  licenseNumber  String        @map("license_number") @db.VarChar(30)
  primary        Boolean       @default(false)
  guide          DespatchGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, documentType, documentNumber])
  @@index([guideId, primary])
  @@map("despatch_guide_driver")
}

model DespatchGuideItem {
  id          String        @id @default(uuid()) @db.Uuid
  guideId     String        @map("guide_id") @db.Uuid
  lineNumber  Int           @map("line_number")
  externalId  String        @map("external_id") @db.VarChar(100)
  sku         String?       @db.VarChar(60)
  description String        @db.VarChar(500)
  quantity    Decimal       @db.Decimal(18, 10)
  unitCode    String        @map("unit_code") @db.VarChar(10)
  guide       DespatchGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, lineNumber])
  @@unique([guideId, externalId])
  @@map("despatch_guide_item")
}

model DespatchGuideArtifact {
  id          String        @id @default(uuid()) @db.Uuid
  guideId     String        @map("guide_id") @db.Uuid
  type        ArtifactType
  fileName    String        @map("file_name") @db.VarChar(180)
  objectKey   String        @map("object_key") @db.VarChar(600)
  contentType String        @map("content_type") @db.VarChar(100)
  sizeBytes   Int           @map("size_bytes")
  sha256      String        @db.Char(64)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  guide       DespatchGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, type])
  @@index([guideId, createdAt])
  @@map("despatch_guide_artifact")
}

model DailySummary {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  environment    Environment
  referenceDate  DateTime           @map("reference_date") @db.Date
  generationDate DateTime           @map("generation_date") @db.Date
  sequence       Int
  status         DailySummaryStatus @default(BUILDING)
  fileName       String?            @map("file_name") @db.VarChar(180)
  xmlObjectKey   String?            @map("xml_object_key") @db.VarChar(600)
  zipObjectKey   String?            @map("zip_object_key") @db.VarChar(600)
  cdrObjectKey   String?            @map("cdr_object_key") @db.VarChar(600)
  ticket         String?            @db.VarChar(100)
  sunatCode      String?            @map("sunat_code") @db.VarChar(40)
  sunatMessage   String?            @map("sunat_message") @db.VarChar(1000)
  submittedAt    DateTime?          @map("submitted_at") @db.Timestamptz(6)
  respondedAt    DateTime?          @map("responded_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items          DailySummaryItem[]

  @@unique([tenantId, environment, generationDate, sequence])
  @@index([status, createdAt])
  @@index([tenantId, environment, referenceDate])
  @@map("daily_summary")
}

model DailySummaryItem {
  id            String                 @id @default(uuid()) @db.Uuid
  summaryId     String                 @map("summary_id") @db.Uuid
  documentId    String                 @map("document_id") @db.Uuid
  voidRequestId String?                @unique @map("void_request_id") @db.Uuid
  lineId        Int                    @map("line_id")
  conditionCode String                 @default("1") @map("condition_code") @db.VarChar(1)
  status        DailySummaryItemStatus @default(PENDING)
  sunatCode     String?                @map("sunat_code") @db.VarChar(40)
  sunatMessage  String?                @map("sunat_message") @db.VarChar(1000)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  summary       DailySummary           @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  document      TaxDocument            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  voidRequest   SunatVoidRequest?      @relation(fields: [voidRequestId], references: [id], onDelete: Restrict)

  @@unique([summaryId, lineId])
  @@unique([summaryId, documentId])
  @@index([summaryId, status])
  @@index([documentId, conditionCode, createdAt])
  @@map("daily_summary_item")
}

model SunatVoidRequest {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  applicationId     String                 @map("application_id") @db.Uuid
  environment       Environment
  taxDocumentId     String?                @unique @map("tax_document_id") @db.Uuid
  despatchGuideId   String?                @unique @map("despatch_guide_id") @db.Uuid
  documentType      DocumentType           @map("document_type")
  procedure         SunatVoidProcedure
  status            SunatVoidRequestStatus @default(PENDING)
  referenceDate     DateTime               @map("reference_date") @db.Date
  series            String                 @db.VarChar(4)
  number            Int
  reason            String                 @db.VarChar(100)
  requestPayload    Json                   @map("request_payload")
  attempts          Int                    @default(0)
  ticket            String?                @db.VarChar(100)
  sunatCode         String?                @map("sunat_code") @db.VarChar(40)
  sunatMessage      String?                @map("sunat_message") @db.VarChar(1000)
  submittedAt       DateTime?              @map("submitted_at") @db.Timestamptz(6)
  respondedAt       DateTime?              @map("responded_at") @db.Timestamptz(6)
  completedAt       DateTime?              @map("completed_at") @db.Timestamptz(6)
  manualReference   String?                @map("manual_reference") @db.VarChar(100)
  manualEvidence    Json?                  @map("manual_evidence")
  manualConfirmedAt DateTime?              @map("manual_confirmed_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  application       Application            @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  taxDocument       TaxDocument?           @relation(fields: [taxDocumentId], references: [id], onDelete: Restrict)
  despatchGuide     DespatchGuide?         @relation(fields: [despatchGuideId], references: [id], onDelete: Restrict)
  summaryItem       DailySummaryItem?
  job               SunatVoidJob?
  webhookEvents     WebhookEvent[]

  @@unique([tenantId, environment, documentType, series, number])
  @@index([applicationId, environment, status, createdAt])
  @@index([tenantId, procedure, status, createdAt])
  @@map("sunat_void_request")
}

model SunatVoidJob {
  id               String            @id @default(uuid()) @db.Uuid
  voidRequestId    String            @unique @map("void_request_id") @db.Uuid
  status           EmissionJobStatus @default(PENDING)
  attempts         Int               @default(0)
  maxAttempts      Int               @default(20) @map("max_attempts")
  nextAttemptAt    DateTime          @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt         DateTime?         @map("locked_at") @db.Timestamptz(6)
  lockedBy         String?           @map("locked_by") @db.VarChar(100)
  lastErrorCode    String?           @map("last_error_code") @db.VarChar(40)
  lastErrorMessage String?           @map("last_error_message") @db.VarChar(1000)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt      DateTime?         @map("processed_at") @db.Timestamptz(6)
  voidRequest      SunatVoidRequest  @relation(fields: [voidRequestId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("sunat_void_job")
}

model TaxDocumentLine {
  id                   String      @id @default(uuid()) @db.Uuid
  documentId           String      @map("document_id") @db.Uuid
  lineNumber           Int         @map("line_number")
  externalId           String      @map("external_id") @db.VarChar(100)
  sku                  String?     @db.VarChar(60)
  description          String      @db.VarChar(500)
  unitCode             String      @map("unit_code") @db.VarChar(10)
  quantity             Decimal     @db.Decimal(18, 10)
  unitPrice            Decimal     @map("unit_price") @db.Decimal(18, 10)
  unitPriceIncludesTax Boolean     @map("unit_price_includes_tax")
  taxAffectationCode   String      @map("tax_affectation_code") @db.VarChar(4)
  unitValue            Decimal     @map("unit_value") @db.Decimal(18, 10)
  discountAmount       Decimal     @default(0) @map("discount_amount") @db.Decimal(18, 2)
  lineValue            Decimal     @map("line_value") @db.Decimal(18, 2)
  taxAmount            Decimal     @map("tax_amount") @db.Decimal(18, 2)
  totalAmount          Decimal     @map("total_amount") @db.Decimal(18, 2)
  document             TaxDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, lineNumber])
  @@map("tax_document_line")
}

model Artifact {
  id          String       @id @default(uuid()) @db.Uuid
  documentId  String       @map("document_id") @db.Uuid
  type        ArtifactType
  fileName    String       @map("file_name") @db.VarChar(180)
  objectKey   String       @map("object_key") @db.VarChar(600)
  contentType String       @map("content_type") @db.VarChar(100)
  sizeBytes   Int          @map("size_bytes")
  sha256      String       @db.Char(64)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  document    TaxDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, type])
  @@index([documentId, createdAt])
  @@map("artifact")
}

model PaymentInstallment {
  id         String      @id @default(uuid()) @db.Uuid
  documentId String      @map("document_id") @db.Uuid
  number     Int
  amount     Decimal     @db.Decimal(18, 2)
  dueDate    DateTime    @map("due_date") @db.Date
  document   TaxDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, number])
  @@map("payment_installment")
}

model IdempotencyRecord {
  id             String      @id @default(uuid()) @db.Uuid
  applicationId  String      @map("application_id") @db.Uuid
  key            String      @db.VarChar(100)
  requestHash    String      @map("request_hash") @db.VarChar(64)
  resourceType   String      @map("resource_type") @db.VarChar(50)
  resourceId     String      @map("resource_id") @db.VarChar(100)
  responseStatus Int         @map("response_status")
  responseBody   Json        @map("response_body")
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}

model EmissionJob {
  id               String            @id @default(uuid()) @db.Uuid
  documentId       String            @map("document_id") @db.Uuid
  operation        EmissionOperation @default(ISSUE)
  status           EmissionJobStatus @default(PENDING)
  attempts         Int               @default(0)
  maxAttempts      Int               @default(10) @map("max_attempts")
  nextAttemptAt    DateTime          @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt         DateTime?         @map("locked_at") @db.Timestamptz(6)
  lockedBy         String?           @map("locked_by") @db.VarChar(100)
  lastErrorCode    String?           @map("last_error_code") @db.VarChar(40)
  lastErrorMessage String?           @map("last_error_message") @db.VarChar(1000)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt      DateTime?         @map("processed_at") @db.Timestamptz(6)
  document         TaxDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)

